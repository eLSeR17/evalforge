# evalforge configuration — copy to .env and adjust locally.
# NEVER commit a real .env; keep these as placeholders.

# Ollama LLM-as-judge endpoint. Inside the docker_default network the service
# name is reachable; never use localhost from a container.
OLLAMA_URL=http://ollama:11434

# Model used as the judge (must be pulled in Ollama).
OLLAMA_MODEL=qwen2.5:7b

# Optional regression-threshold overrides, comma-separated key=value pairs.
# The CLI --threshold flag wins over this value.
# Example: EVALFORGE_THRESHOLD=min_answer_rate=0.80,min_context_recall=0.40
EVALFORGE_THRESHOLD=
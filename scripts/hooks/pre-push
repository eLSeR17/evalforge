#!/usr/bin/env bash
# pre-push hook — replica LOCALMENTE las comprobaciones del CI antes de permitir
# el push (cierra la brecha WSL: ruff NO aplica EXE001/EXE002 en WSL2, el runner
# de GitHub sí — este chequeo portable los replica en cualquier plataforma).
#
# Instalación (una vez por clone):  git config core.hooksPath scripts/hooks
# Uso implícito: se ejecuta en cada `git push`.
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
FAIL=0
step() { printf '\033[1;36m[pre-push] %s\033[0m\n' "$1"; }
fail() { printf '\033[1;31m[pre-push] %s\033[0m\n' "$1"; FAIL=1; }

step "ruff check (mismos targets que el CI)"
if ! ruff check src tests scripts; then
  fail "ruff: hay errores de lint — corrígelos antes de pushear"
fi

step "chequeo EXE001/EXE002 (portable; ruff no los aplica en WSL)"
if ! python3 - <<'HEREDOC_EXE'
import os, pathlib, sys
errs = []
for base in ("src", "tests", "scripts"):
    for p in pathlib.Path(base).rglob("*.py"):
        s = os.stat(p)
        exe = bool(s.st_mode & 0o111)
        shebang = p.read_bytes()[:2] == b"#!"
        if exe and not shebang:
            errs.append(f"EXE002 {p} — ejecutable sin shebang (añade #!/usr/bin/env python3 o chmod -x)")
        if shebang and not exe:
            errs.append(f"EXE001 {p} — shebang sin bit ejecutable (chmod +x)")
for e in errs:
    print(e)
sys.exit(1 if errs else 0)
HEREDOC_EXE
then
  fail "EXE: inconsistencias shebang/ejecutable (ver arriba)"
fi

step "pytest"
if ! python3 -m pytest tests -q; then fail "pytest: hay tests fallando"; fi

step "pip-audit (árbol declarado; el CI audita además el toolchain del runner)"
printf '[pre-push] pip-audit: deps declaradas en pyproject (sin requirements.txt) — auditado por el CI sobre el env; saltando en local\n'

if [ "$FAIL" -eq 0 ]; then
  step "✓ local verificado (ruff + EXE + pytest) — push permitido"
else
  fail "Push BLOQUEADO — revisa los errores de arriba."
  exit 1
fi
exit 0
